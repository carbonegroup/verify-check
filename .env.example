# VerifyCheck — variables d'environnement
# Copier en .env.local pour le développement local.
# Les variables NEXT_PUBLIC_* sont intégrées au client ; ne pas y placer de secret.
# Les variables sans préfixe NEXT_PUBLIC_* restent côté serveur.

NEXT_PUBLIC_SUPABASE_URL=https://hdfefhltqyxiqnuruhlp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_6QbAwQ2hnt8qCeUPVCXJ5w_MSO0APSP

# Clé privilégiée serveur uniquement — ne jamais préfixer par NEXT_PUBLIC_
# Nécessaire pour les routes DEV de gestion des comptes.
SUPABASE_SERVICE_ROLE_KEY=

# URL HTTPS exacte de la page d'acceptation/récupération.
# Elle doit aussi être ajoutée à Supabase Auth > URL Configuration > Redirect URLs.
AUTH_ACCOUNT_REDIRECT_URL=https://VOTRE-DOMAINE/auth/complete
